---
import { services } from '../data/services';

// Links to the other service pages, shown at the end of each service page.
const current = Astro.url.pathname.replace(/\/$/, '');
const others = services.filter((s) => s.route !== current);
---

<section class="related-services" aria-labelledby="related-services-heading">
  <div class="container">
    <h2 id="related-services-heading" data-lang-de="Weitere Leistungen" data-lang-ru="Другие услуги">Weitere Leistungen</h2>
    <ul>
      {others.map((s) => (
        <li><a href={`${s.route}/`} data-lang-de={s.title} data-lang-ru={s.titleRu}>{s.title}</a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .related-services {
    padding: 56px 0 72px;
    background-color: #F7F8FB;
  }
  .related-services h2 {
    text-align: center;
    font-size: 26px;
    margin-bottom: 24px;
  }
  .related-services ul {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 900px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .related-services a {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid #2C3E6B;
    border-radius: 999px;
    color: #2C3E6B;
    text-decoration: none;
    font-size: 15px;
    background-color: #FFFFFF;
  }
  .related-services a:hover {
    background-color: #2C3E6B;
    color: #FFFFFF;
  }
</style>
