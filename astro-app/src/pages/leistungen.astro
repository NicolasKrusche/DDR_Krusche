---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { services } from '../data/services';

---

<Layout
  title="Leistungen — Frauenärztin DDr. Anastasiya Krusche, Mödling"
  description="Alle gynäkologischen Leistungen von DDr. Krusche: Verhütungsberatung, Vorsorgeuntersuchung, Familienplanung, Genetische Beratung, Jugendgynäkologie, Impfungen, Wechseljahre, Ultraschall, Beckenbodenstimulation mit EMSELLA (HIFEM)."
  titleRu="Наши услуги — Доктор Анастасия Круше | Гинеколог"
  descriptionRu="Все гинекологические услуги доктора Круше: консультации по контрацепции, профилактические осмотры, планирование семьи, генетическое консультирование, подростковая гинекология, вакцинация, менопауза, УЗИ, стимуляция тазового дна (HIFEM)."
>
  <Navbar slot="navbar" />

  <section class="leistungen-section" aria-labelledby="leistungen-heading">
    <div class="container">
      <div class="leistungen-header">
        <h1 id="leistungen-heading" data-lang-de="Unsere Leistungen" data-lang-ru="Наши услуги">Unsere Leistungen</h1>
        <p data-lang-de="Gynäkologische Betreuung auf höchstem Niveau" data-lang-ru="Гинекологическая помощь на высшем уровне">Gynäkologische Betreuung auf höchstem Niveau</p>
      </div>
      <div class="leistungen-grid">
        {services.map(svc => (
          <a class="leistung-card" href={svc.route}>
            <img class="leistung-card-img" src={svc.image} alt={svc.alt} loading="lazy" width="300" height="180" />
            <div class="leistung-card-body">
              <h2 style="font-size:18px;margin-bottom:8px;" data-lang-de={svc.title} data-lang-ru={svc.titleRu}>{svc.title}</h2>
              <span data-lang-de="Mehr erfahren" data-lang-ru="Подробнее">Mehr erfahren</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
