---
export interface Props {
  image: string;
  alt?: string;
  title: string;
  titleRu?: string;
  subtitle?: string;
  subtitleRu?: string;
}
const { image, alt = '', title, titleRu, subtitle, subtitleRu } = Astro.props;
---

<section class="page-hero">
  <img class="page-hero-image" src={image} alt={alt} loading="eager" />
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content">
    <h1 data-lang-de={titleRu ? title : undefined} data-lang-ru={titleRu}>{title}</h1>
    {subtitle && <p class="page-hero-subtitle" data-lang-de={subtitleRu ? subtitle : undefined} data-lang-ru={subtitleRu}>{subtitle}</p>}
  </div>
</section>
